# Project ARGUS backend configuration.
# Copy to backend/.env and fill in. Every variable is optional unless stated;
# unset dependencies make their endpoints return 503 with an explicit reason
# rather than silently degrading.

# ---------------------------------------------------------------- runtime
ARGUS_ENVIRONMENT=local
# Prefix every route is mounted under.
ARGUS_API_PREFIX=/api/v1
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=false
# Comma separated. Required for the Next.js frontend to call the API from a browser.
# The frontend's package.json runs `next dev -p 3001`, not Next's default 3000 -
# this must match whatever port it's actually served on or the browser blocks
# every request with no server-side error to point at (CORSMiddleware is only
# added at all when this list is non-empty - see app/main.py).
ARGUS_CORS_ORIGINS=http://localhost:3001

# --------------------------------------------------------------- database
# REQUIRED for every attendance endpoint. Must use the asyncpg driver.
ARGUS_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
ARGUS_DB_POOL_SIZE=10
ARGUS_DB_MAX_OVERFLOW=20
ARGUS_DB_STATEMENT_TIMEOUT_MS=15000
ARGUS_DB_ECHO=false

# ------------------------------------------------------- attendance capture
# How often buffered recognitions are written to PostgreSQL while a session is
# ACTIVE. Lower = more granular register, more write round trips.
ARGUS_CAPTURE_INTERVAL_SECONDS=15
ARGUS_CAPTURE_FLUSH_CHUNK_SIZE=2000
ARGUS_CAPTURE_MAX_BUFFERED_SESSIONS=256

# ------------------------------------------------------ recognition thresholds
# PLACEHOLDERS - leave empty until they are calibrated on the validation set.
# While any of them is empty the API can only answer HUMAN_REVIEW / UNKNOWN and
# will never mark attendance automatically. See docs/benchmarks.md ->
# "Calibrating the thresholds" for how to derive them, and
# evaluation/calibrate_thresholds.py for a reference calibration run on a
# labelled (non-production) probe set - a sanity check, not a value to paste
# in unexamined.
ARGUS_MATCH_THRESHOLD=
ARGUS_REVIEW_THRESHOLD=
ARGUS_MINIMUM_MARGIN=

# ------------------------------------------------------------ model adapters
# Point MODEL_ROOT at the InsightFace buffalo_l ONNX pack and the SCRFD detector
# and ArcFace embedder load from it by filename (det_10g.onnx, w600k_r50.onnx).
# Leave it empty and those two components stay unconfigured: their endpoints
# return 503 naming this variable instead of guessing.
ARGUS_MODEL_ROOT=../models/buffalo_l
# Only needed to override an individual file inside the pack.
ARGUS_DETECTOR_MODEL_PATH=
ARGUS_EMBEDDER_MODEL_PATH=
ARGUS_EMBEDDING_DIM=512
# Mask synthesis is geometric and needs no model file, so it is always available.
ARGUS_MASK_VARIANTS=surgical_blue,surgical_white,cloth_black,cloth_colored,n95,improper_low

# ------------------------------------------------------------- onnx runtime
# Comma separated, tried in order; unavailable ones are dropped with a warning.
# Add CUDAExecutionProvider first on a GPU host (needs onnxruntime-gpu).
ARGUS_ONNX_PROVIDERS=CPUExecutionProvider
# 0 keeps onnxruntime's own default thread count.
ARGUS_ONNX_INTRA_OP_THREADS=0
# Used only when the detector graph has dynamic height/width, as det_10g.onnx does.
ARGUS_DETECTION_INPUT_SIZE=640
ARGUS_DETECTION_SCORE_THRESHOLD=0.5
ARGUS_DETECTION_NMS_IOU=0.4
ARGUS_DETECTION_MAX_FACES=100

# ------------------------------------------------------- offline attendance runs
# POST /recognize/video and /recognize/batch feed the same capture buffer as the
# live stream, so absence is still only decided at session close.
ARGUS_VIDEO_MAX_BYTES=268435456
# Process every Nth frame; 1 processes every frame.
ARGUS_VIDEO_FRAME_STRIDE=5
ARGUS_VIDEO_MAX_FRAMES=5000
ARGUS_BATCH_MAX_ARCHIVE_BYTES=268435456
ARGUS_BATCH_MAX_FILES=2000

# ------------------------------------------------------- registration import
# Limits for POST /students/import (CSV plus an optional ZIP of photographs).
ARGUS_IMPORT_MAX_CSV_BYTES=16777216
ARGUS_IMPORT_MAX_ARCHIVE_BYTES=1073741824
ARGUS_IMPORT_MAX_ROWS=50000

# Image quality gates. Empty = gate reported as uncalibrated and skipped.
ARGUS_ENROLLMENT_MIN_FACE_PIXELS=
ARGUS_ENROLLMENT_MIN_BLUR_VARIANCE=
ARGUS_ENROLLMENT_MAX_IMAGE_BYTES=8388608
ARGUS_RECOGNITION_MAX_FRAME_BYTES=4194304

# ------------------------------------------------------------- vector index
# disabled | persistent | http
ARGUS_CHROMA_MODE=disabled
ARGUS_CHROMA_PATH=./.chroma
ARGUS_CHROMA_HOST=
ARGUS_CHROMA_PORT=
ARGUS_CHROMA_COLLECTION=argus_templates
ARGUS_CHROMA_SEARCH_K=10

# ------------------------------------------------------------ object storage
# Enrollment photographs sent to POST /students/import are uploaded here before
# the row is written, because students.image_url is NOT NULL. With mode=disabled
# an import that carries images fails with 503 rather than inventing a URL; rows
# that already quote an https image_url work either way.
# disabled | local | r2
ARGUS_OBJECT_STORAGE_MODE=disabled
ARGUS_STORAGE_KEY_PREFIX=enrollment
# mode=local: images are written here, served from ARGUS_MEDIA_URL_PATH, and the
# URL stored in students.image_url is ARGUS_LOCAL_PUBLIC_BASE_URL + the key.
ARGUS_LOCAL_STORAGE_PATH=./.media
ARGUS_MEDIA_URL_PATH=/media
ARGUS_LOCAL_PUBLIC_BASE_URL=http://localhost:8000/media
# All five are required when mode=r2.
ARGUS_R2_ENDPOINT_URL=
ARGUS_R2_BUCKET=
ARGUS_R2_ACCESS_KEY_ID=
ARGUS_R2_SECRET_ACCESS_KEY=
ARGUS_R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------ campus CCTV
# Each *_RTSP_URL carries that camera's own credentials
# (rtsp://user:pass@ip:port/path) - keep them only here, never in ARGUS_CORS_ORIGINS
# or anything the frontend reads. A camera with no RTSP URL set just doesn't show
# up in GET /cameras. See app/services/camera.py for the MJPEG proxy this feeds.
ARGUS_CAMERA_STEPS_LABEL=Near Steps
ARGUS_CAMERA_STEPS_RTSP_URL=
ARGUS_CAMERA_WALL_LABEL=Wall Attached
ARGUS_CAMERA_WALL_RTSP_URL=
# Frames/sec re-served to the browser; independent of the camera's own frame rate.
ARGUS_CAMERA_MJPEG_FPS=8
ARGUS_CAMERA_RECONNECT_SECONDS=5

# ------------------------------------------------------------- tests / benchmarks
# Throwaway databases. The benchmark refuses to run if it equals ARGUS_DATABASE_URL.
ARGUS_TEST_DATABASE_URL=
ARGUS_BENCH_DATABASE_URL=
